# Copier en .env et compléter. Utilisé par docker-compose (dev et prod).

# --- Base de données ---
POSTGRES_USER=kairos
POSTGRES_PASSWORD=change-moi-en-prod
POSTGRES_DB=kairos

# --- API RTVC (Kairos s'y branche) ---
RTVC_BASE_URL=https://api.rtvc-media.com
RTVC_USERNAME=votre-utilisateur-rtvc
RTVC_PASSWORD=votre-mot-de-passe-rtvc
RTVC_OTP_CODE=

# --- Dossier local de vidéos à indexer (monté en lecture seule) ---
# En dev (Windows) : C:/Users/vous/Videos
# Sur le NAS Synology : /volume1/ACCES_UTILISATEURS/Rtvc2026  (par ex.)
MEDIA_INPUT_DIR=./media_in

# --- Production (docker-compose.prod.yml) ---
KAIROS_PORT=8090          # port exposé sur l'hôte (cible du reverse proxy)
API_WORKERS=2             # process uvicorn pour l'API
WORKER_CONCURRENCY=1      # tâches d'indexation en parallèle (RAM/CPU)

# Secret optionnel du webhook RTVC -> Kairos
WEBHOOK_SECRET=

# Mot de passe d'accès à l'application (OBLIGATOIRE si exposée sur Internet).
# Vide = accès libre (uniquement pour le dev local).
KAIROS_PASSWORD=

# Origines externes autorisees a appeler l'API (CORS), separees par des virgules.
# Vide = aucune (recommande) : l'interface est servie par le meme serveur.
CORS_ORIGINS=
